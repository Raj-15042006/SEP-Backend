# ====================================================================
# Skills Evidence Passport — Backend Configuration Template
# (Non-confidential template: populate with your credentials before running)
# ====================================================================

PORT=8080
SPRING_PROFILES_ACTIVE=local

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres.your_project:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_PROJECT_ID=your-project-id

# Redis Configuration (Token Bucket Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage (Evidence Artifacts)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=evidence-artefacts
