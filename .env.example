# ====================================================================
# Skills Evidence Passport — Backend Configuration Template
# (Non-confidential template: populate with your credentials before running)
# ====================================================================

PORT=8080
SPRING_PROFILES_ACTIVE=supabase

# Production Frontend CORS URL
FRONTEND_URL=https://skillevidencepassport.netlify.app

# Database Configuration (Supabase Session Pooler - IPv4 Compatible JDBC URL)
DATABASE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.your_project_id
SUPABASE_DB_PASSWORD=your_database_password

# Supabase API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PROJECT_ID=your-project-id

# Cryptographic Token Secret (HMAC-SHA256)
PASSPORT_SECURITY_JWT_SECRET=your_long_random_jwt_secret_here

# Rate Limiting Configuration (false uses in-memory token bucket; set true when Redis is deployed)
RATELIMIT_ENABLED=true
RATELIMIT_USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage (Optional for initial deployment)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=evidence-artefacts
